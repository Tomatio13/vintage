{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VINTAGE",
  "version": "0.2.0",
  "identifier": "dev.tiebi.vintage",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VINTAGE",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCNzE5MkE4MzkzMDEwRjAKUldUd0VEQTVxSkp4cS9OK0xpWklvZWthQzFIM0FiT09MN2p2em56blBDSWZHenVhR3BGMlF3bFkK",
      "endpoints": [
        "https://github.com/Tomatio13/vintage/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
