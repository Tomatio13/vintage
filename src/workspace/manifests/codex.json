{
  "id": "codex",
  "version": "2026.07.18.1",
  "updatedAt": "2026-07-18T00:00:00Z",
  "rules": [
    {
      "id": "osc_title_blocked",
      "state": "blocked",
      "priority": 1100,
      "region": { "kind": "osc_title" },
      "visibleBlocker": true,
      "condition": { "contains": ["Action Required"] }
    },
    {
      "id": "osc_title_working",
      "state": "working",
      "priority": 1050,
      "region": { "kind": "osc_title" },
      "visibleWorking": true,
      "condition": { "regex": "(?:^| )[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏](?: |$)" }
    },
    {
      "id": "transcript_viewer",
      "state": "unknown",
      "priority": 1000,
      "region": { "kind": "after_last_prompt_marker" },
      "skipStateUpdate": true,
      "condition": {
        "contains": [
          "↑/↓ to scroll",
          "pgup/pgdn to",
          "home/end to jump",
          "q to quit"
        ],
        "any": [
          { "contains": ["esc to edit prev"] },
          { "contains": ["esc/← to edit prev"] }
        ]
      }
    },
    {
      "id": "live_strong_blocker",
      "state": "blocked",
      "priority": 900,
      "region": { "kind": "after_last_prompt_marker" },
      "visibleBlocker": true,
      "condition": {
        "any": [
          { "contains": ["press enter to confirm or esc to cancel"] },
          { "contains": ["enter to submit answer"] },
          { "contains": ["enter to submit all"] },
          { "contains": ["allow command?"] }
        ]
      }
    },
    {
      "id": "weak_blocker",
      "state": "blocked",
      "priority": 600,
      "region": { "kind": "whole_recent" },
      "condition": {
        "any": [
          { "contains": ["[y/n]"] },
          { "contains": ["yes (y)"] },
          {
            "contains": ["do you want to"],
            "any": [{ "contains": ["yes"] }, { "contains": ["❯"] }]
          },
          {
            "contains": ["would you like to"],
            "any": [{ "contains": ["yes"] }, { "contains": ["❯"] }]
          }
        ]
      }
    },
    {
      "id": "screen_working_fallback",
      "state": "working",
      "priority": 500,
      "region": { "kind": "bottom_lines", "n": 3 },
      "visibleWorking": true,
      "condition": {
        "lineRegex": [
          "^[•◦]\\s+Working \\([^)]*esc to interrupt\\)(?: · .*)?$"
        ],
        "not": [{ "contains": ["■ Conversation interrupted"] }]
      }
    },
    {
      "id": "osc_title_idle",
      "state": "idle",
      "priority": 100,
      "region": { "kind": "osc_title" },
      "visibleIdle": true,
      "condition": {
        "regex": "\\S",
        "not": [
          { "regex": "(?:^| )[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏](?: |$)" },
          { "contains": ["Action Required"] }
        ]
      }
    }
  ]
}
