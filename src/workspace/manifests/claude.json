{
  "id": "claude",
  "version": "2026.07.13.1",
  "updatedAt": "2026-07-13T00:00:00Z",
  "rules": [
    {
      "id": "osc_title_working",
      "state": "working",
      "priority": 1100,
      "region": { "kind": "osc_title" },
      "visibleWorking": true,
      "condition": { "regex": "^[\\u{2800}-\\u{28FF}] " }
    },
    {
      "id": "btw_overlay_working",
      "state": "working",
      "priority": 975,
      "region": { "kind": "bottom_lines", "n": 5 },
      "visibleWorking": true,
      "condition": {
        "lineRegex": ["^\\s*/btw(?:\\s|$)", "(?i)esc to close\\s*$"]
      }
    },
    {
      "id": "transcript_viewer",
      "state": "unknown",
      "priority": 1000,
      "region": { "kind": "bottom_lines", "n": 3 },
      "skipStateUpdate": true,
      "condition": {
        "contains": ["showing detailed transcript"],
        "any": [
          { "contains": ["ctrl+o", "to toggle"] },
          { "contains": ["ctrl+e", "show all"] },
          { "contains": ["ctrl+e", "collapse"] },
          { "contains": ["↑↓ scroll"] },
          { "contains": ["? for shortcuts"] }
        ]
      }
    },
    {
      "id": "live_blocked_form",
      "state": "blocked",
      "priority": 980,
      "region": { "kind": "after_last_horizontal_rule" },
      "visibleBlocker": true,
      "condition": {
        "contains": ["enter to select", "esc to cancel"],
        "any": [
          { "contains": ["tab/arrow keys to navigate"] },
          { "contains": ["arrow keys to navigate"] },
          { "contains": ["arrows to navigate"] },
          { "contains": ["↑/↓ to navigate"] },
          { "contains": ["↑↓ to navigate"] }
        ]
      }
    },
    {
      "id": "dynamic_workflow_prompt",
      "state": "blocked",
      "priority": 980,
      "region": { "kind": "whole_recent" },
      "visibleBlocker": true,
      "condition": {
        "contains": ["run a dynamic workflow?", "esc to cancel"]
      }
    },
    {
      "id": "live_prompt_box",
      "state": "idle",
      "priority": 950,
      "region": { "kind": "prompt_box_body" },
      "visibleIdle": true,
      "condition": {
        "lineRegex": ["^\\s*❯"],
        "not": [
          { "contains": ["enter to select"] },
          { "contains": ["esc to cancel"] },
          { "contains": ["tab/arrow keys"] },
          { "contains": ["arrow keys to navigate"] },
          { "contains": ["↑/↓ to navigate"] }
        ]
      }
    },
    {
      "id": "model_picker_menu",
      "state": "unknown",
      "priority": 900,
      "region": { "kind": "whole_recent" },
      "skipStateUpdate": true,
      "condition": {
        "contains": [
          "select model",
          "enter to set as default",
          "esc to cancel"
        ],
        "not": [
          { "contains": ["do you want to proceed?"] },
          { "contains": ["enter to select"] }
        ]
      }
    },
    {
      "id": "bash_permission_prompt",
      "state": "blocked",
      "priority": 850,
      "region": { "kind": "whole_recent" },
      "visibleBlocker": true,
      "condition": {
        "contains": ["do you want to proceed?"],
        "any": [
          { "contains": ["bash command"] },
          { "contains": ["bash("] },
          { "contains": ["contains expansion"] },
          { "contains": ["tab to amend"] },
          { "contains": ["ctrl+e to explain"] }
        ],
        "all": [
          {
            "any": [
              { "lineRegex": ["(?i)^\\s*❯?\\s*yes\\b"] },
              { "lineRegex": ["(?i)^\\s*1\\.\\s*yes\\b"] },
              { "lineRegex": ["(?i)^\\s*2\\.\\s*no\\b"] }
            ]
          }
        ]
      }
    },
    {
      "id": "generic_permission_prompt",
      "state": "blocked",
      "priority": 840,
      "region": { "kind": "after_last_horizontal_rule" },
      "visibleBlocker": true,
      "condition": {
        "contains": ["do you want to proceed?", "esc to cancel"],
        "all": [
          {
            "any": [
              { "lineRegex": ["(?i)^\\s*❯?\\s*1\\.\\s*yes\\b"] },
              { "lineRegex": ["(?i)^\\s*2\\.\\s*yes\\b"] },
              { "lineRegex": ["(?i)^\\s*2\\.\\s*no\\b"] },
              { "lineRegex": ["(?i)^\\s*3\\.\\s*no\\b"] }
            ]
          }
        ]
      }
    },
    {
      "id": "legacy_no_prompt_blocker",
      "state": "blocked",
      "priority": 300,
      "region": { "kind": "whole_recent" },
      "condition": {
        "any": [
          {
            "contains": ["do you want to"],
            "any": [{ "contains": ["yes"] }, { "contains": ["❯"] }]
          },
          {
            "contains": ["would you like to"],
            "any": [{ "contains": ["yes"] }, { "contains": ["❯"] }]
          },
          { "contains": ["waiting for permission"] },
          { "contains": ["do you want to allow this connection?"] },
          { "contains": ["tab to amend"] },
          { "contains": ["ctrl+e to explain"] },
          { "contains": ["do you want to proceed?", "esc to cancel"] },
          { "contains": ["review your answers"] },
          { "contains": ["skip interview and plan immediately"] }
        ],
        "not": [{ "regex": "(?m)^\\s*❯\\s*$" }]
      }
    },
    {
      "id": "osc_title_idle",
      "state": "idle",
      "priority": 250,
      "region": { "kind": "osc_title" },
      "visibleIdle": true,
      "condition": { "regex": "^\\u{2733} " }
    },
    {
      "id": "osc_progress_idle",
      "state": "idle",
      "priority": 250,
      "region": { "kind": "osc_progress" },
      "condition": { "regex": "^4;0" }
    }
  ]
}
